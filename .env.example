# Local PostgreSQL (see docker-compose.yml)
DATABASE_URL=postgresql://agensync:agensync@localhost:5433/agensync

# Ollama, reached over Tailscale — a separate machine, not managed by Docker Compose here
OLLAMA_BASE_URL=
AI_PROVIDER=ollama

# Gmail integration (Phase 9) — from a Google Cloud project with the Gmail
# API enabled and an OAuth consent screen configured. Optional: the app runs
# fine without these, only /settings' "Connect Gmail" flow needs them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback
