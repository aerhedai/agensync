# Local PostgreSQL (see docker-compose.yml)
DATABASE_URL=postgresql://agensync:agensync@localhost:5433/agensync

# Ollama, reached over Tailscale — a separate machine, not managed by Docker Compose here.
# Local dev: point this directly at Ollama and leave OLLAMA_PROXY_SECRET unset.
# Hosted (Preview/Production): point this at scripts/ollama-auth-proxy.py's public
# Tailscale Funnel URL instead, and set OLLAMA_PROXY_SECRET to match — see
# docs/production-notes.md.
OLLAMA_BASE_URL=
AI_PROVIDER=ollama
OLLAMA_PROXY_SECRET=

# Gmail integration (Phase 9) — from a Google Cloud project with the Gmail
# API enabled and an OAuth consent screen configured. Optional: the app runs
# fine without these, only /settings' "Connect Gmail" flow needs them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback

# Slack integration (notify_slack) — from a Slack App (api.slack.com) with
# Bot Token Scopes chat:write and chat:write.public, and this redirect URL
# added under OAuth & Permissions. Optional: only /settings' "Add Slack
# account" flow needs these.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/api/integrations/slack/callback

# Microsoft integrations (Outlook Mail, Teams, Outlook Calendar) — one Azure
# AD / Entra ID app registration (portal.azure.com > App registrations) backs
# all three: same client id/secret, delegated Graph API permissions
# Mail.Read, Mail.Send, ChannelMessage.Send, Calendars.ReadWrite, User.Read,
# offline_access. Each product calls back to its own route, so each needs
# its own redirect URI added under the app's Authentication settings.
# Optional: the app runs fine without these, only /settings' "Add Outlook
# account" / "Add Teams account" / "Add Outlook Calendar account" flows
# need them.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_OUTLOOK_REDIRECT_URI=http://localhost:3000/api/integrations/outlook/callback
MICROSOFT_TEAMS_REDIRECT_URI=http://localhost:3000/api/integrations/teams/callback
MICROSOFT_CALENDAR_REDIRECT_URI=http://localhost:3000/api/integrations/outlook-calendar/callback

# Auth (Phase B) — from a Clerk application's dashboard (API Keys page).
# Required: every page resolves its organisation/user via Clerk, so the app
# won't run without these. Enable the Organizations feature in the Clerk
# dashboard too, or /select-organisation will error.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Encrypts Gmail OAuth tokens at rest (lib/crypto/token-cipher.ts). Generate
# with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
