# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code — personal overrides and ephemeral hook state, not team policy
.claude/settings.local.json
.claude/.frontend-dirty

/lib/generated/prisma

# local prompt transcript — not for the repo (see CLAUDE.md #40)
/transcript/

# local screenshot artifacts from manual UI verification (repo-root only —
# doesn't affect real image assets committed under public/ etc.)
/.playwright-mcp/
/*.png
