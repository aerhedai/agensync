generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  APPROVER
}

enum AgentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum RunStatus {
  PENDING
  RUNNING
  WAITING_FOR_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum RunStepType {
  INPUT_RECEIVED
  AGENT_DECISION
  TOOL_CALL
  APPROVAL_REQUESTED
  APPROVAL_GRANTED
  RUN_COMPLETED
  RUN_FAILED
  RUN_CANCELLED
}

enum ToolCallStatus {
  SUCCESS
  FAILED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum IntegrationProvider {
  GMAIL
}

enum WorkflowTriggerType {
  EMAIL
}

enum WorkflowAgentRole {
  CLASSIFIER
  HANDLER
}

model Organisation {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  agents       Agent[]
  agentRuns    AgentRun[]
  approvals    Approval[]
  integrations Integration[]
  workflows    Workflow[]
}

model User {
  id             String   @id @default(cuid())
  organisationId String
  email          String   @unique
  name           String
  role           UserRole @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation     Organisation @relation(fields: [organisationId], references: [id])
  approvalsDecided Approval[]

  @@index([organisationId])
}

model Agent {
  id             String      @id @default(cuid())
  organisationId String
  name           String
  description    String
  instructions   String
  model          String
  status         AgentStatus @default(DRAFT)
  version        Int         @default(1)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organisation        Organisation    @relation(fields: [organisationId], references: [id])
  runs                AgentRun[]
  tools               AgentTool[]
  workflowMemberships WorkflowAgent[]

  @@index([organisationId])
}

// Which MCP tools this agent may use (CLAUDE.md #9 step 3: "check the
// agent has access to the tool"). Enforced deterministically in
// lib/runtime/agent-runtime.ts before a tool call ever reaches the MCP
// server — a tool absent here is refused even if the model asks for it,
// not just hidden from what's offered.
model AgentTool {
  id       String @id @default(cuid())
  agentId  String
  toolName String

  agent Agent @relation(fields: [agentId], references: [id])

  @@unique([agentId, toolName])
  @@index([agentId])
}

// A named, reusable pipeline: one classifier agent that decides which
// handler agent should deal with an inbound item, plus the handler agents
// themselves (see lib/routing/dispatch.ts). Kept deliberately simple (a
// flat classifier + handlers list, not a generic node graph) — CLAUDE.md
// #24 says not to build a full workflow editor yet — but it's a real,
// separate entity so a business can eventually have more than one workflow
// (e.g. a future quote-to-production pipeline) without a schema rewrite.
model Workflow {
  id             String              @id @default(cuid())
  organisationId String
  name           String
  description    String
  trigger        WorkflowTriggerType
  status         AgentStatus         @default(DRAFT)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organisation Organisation    @relation(fields: [organisationId], references: [id])
  members      WorkflowAgent[]

  @@index([organisationId])
}

model WorkflowAgent {
  id         String            @id @default(cuid())
  workflowId String
  agentId    String
  role       WorkflowAgentRole

  workflow Workflow @relation(fields: [workflowId], references: [id])
  agent    Agent    @relation(fields: [agentId], references: [id])

  @@unique([workflowId, agentId])
  @@index([workflowId])
  @@index([agentId])
}

model AgentRun {
  id             String    @id @default(cuid())
  agentId        String
  organisationId String
  status         RunStatus @default(PENDING)
  input          String
  // Snapshot of the in-progress conversation, saved only when the run
  // pauses for approval — lets resumeRun() pick the loop back up rather
  // than starting the conversation over.
  messages       Json?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  agent        Agent        @relation(fields: [agentId], references: [id])
  organisation Organisation @relation(fields: [organisationId], references: [id])
  steps        RunStep[]
  toolCalls    ToolCall[]
  approvals    Approval[]

  @@index([agentId])
  @@index([organisationId])
}

model RunStep {
  id         String      @id @default(cuid())
  agentRunId String
  stepType   RunStepType
  detail     String?
  toolCallId String?     @unique
  createdAt  DateTime    @default(now())

  agentRun AgentRun  @relation(fields: [agentRunId], references: [id])
  toolCall ToolCall? @relation(fields: [toolCallId], references: [id])

  @@index([agentRunId])
}

model ToolCall {
  id         String         @id @default(cuid())
  agentRunId String
  toolName   String
  input      Json
  output     Json?
  status     ToolCallStatus
  error      String?
  createdAt  DateTime       @default(now())

  agentRun AgentRun @relation(fields: [agentRunId], references: [id])
  runStep  RunStep?

  @@index([agentRunId])
}

model Approval {
  id                 String         @id @default(cuid())
  agentRunId         String
  organisationId     String
  requestedAction    String
  reason             String
  // The exact tool-call arguments being held back pending approval (e.g.
  // {to, subject, body} for send_email) and the LLM's id for that call, so
  // the approver reviews the real proposed content — not just an abstract
  // "an email will be sent" — and resumeRun can execute precisely this call.
  // Null for any future post-execution-only approval (see policy-engine.ts).
  proposedInput      Json?
  proposedToolCallId String?
  status             ApprovalStatus @default(PENDING)
  requestedAt        DateTime       @default(now())
  approverId         String?
  decidedAt          DateTime?

  agentRun     AgentRun     @relation(fields: [agentRunId], references: [id])
  organisation Organisation @relation(fields: [organisationId], references: [id])
  approver     User?        @relation(fields: [approverId], references: [id])

  @@index([agentRunId])
  @@index([organisationId])
}

// Stores one OAuth token set per organisation per provider. Tokens are
// plaintext for V1 — server-side only, never sent to the browser, never
// committed (CLAUDE.md #22) — see docs/production-notes.md for the
// encryption-at-rest hardening this needs before any real deployment.
model Integration {
  id             String              @id @default(cuid())
  organisationId String
  provider       IntegrationProvider
  email          String
  accessToken    String
  refreshToken   String
  expiresAt      DateTime
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@unique([organisationId, provider])
  @@index([organisationId])
}
