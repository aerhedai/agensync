generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  APPROVER
}

enum AgentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum RunStatus {
  PENDING
  RUNNING
  WAITING_FOR_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum RunStepType {
  INPUT_RECEIVED
  AGENT_DECISION
  TOOL_CALL
  APPROVAL_REQUESTED
  APPROVAL_GRANTED
  RUN_COMPLETED
  RUN_FAILED
  RUN_CANCELLED
}

enum ToolCallStatus {
  SUCCESS
  FAILED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WorkflowTriggerType {
  EMAIL
}

enum WorkflowAgentRole {
  CLASSIFIER
  HANDLER
}

// TEMPLATE: a platform-provided, plug-and-play starter workflow (e.g.
// "Email Handling", provisioned automatically for every new org — see
// provision-email-workflow.ts) — a business enables/configures it, doesn't
// author it from nothing. CUSTOM: a business built this one themselves
// from /workflows/new, for a process the platform doesn't ship a starter
// for. Both are ordinary Workflow rows with the same shape and the same
// runtime — this only records provenance, it doesn't change how a
// workflow runs.
enum WorkflowSource {
  TEMPLATE
  CUSTOM
}

// LOOP: the original free-form runtime (lib/runtime/agent-runtime.ts) — the
// model decides which tool to call next, turn by turn. HARNESS: a fixed,
// coded pipeline (lib/harness/) — the model is only asked narrow, atomic
// questions (extract these fields; write this reply from these facts); tool
// sequencing is deterministic code, not a model decision. Both are kept as
// real, supported modes rather than replacing one with the other — some
// future agent's job may not fit a fixed pipeline.
enum AgentExecutionMode {
  LOOP
  HARNESS
}

model Organisation {
  id         String   @id @default(cuid())
  // Clerk's Organization id — the real, session-verified identity every
  // request's org context resolves against (lib/organisations/current-organisation.ts).
  // Required: every Organisation row that exists came from a real Clerk
  // sign-in, provisioned lazily on first sight of a not-yet-seen org.
  clerkOrgId String   @unique
  name       String
  // ISO 4217 code (e.g. "GBP", "USD"). Plain string, not an enum — ISO 4217
  // has ~180 codes; a Postgres enum would need a migration per new currency
  // supported. What the app actually accepts is constrained at the
  // application layer instead (lib/currency/currency-symbols.ts).
  currency   String   @default("GBP")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users               User[]
  agents              Agent[]
  agentRuns           AgentRun[]
  approvals           Approval[]
  integrations        Integration[]
  workflows           Workflow[]
  products            Product[]
  customers           Customer[]
  customEntityTypes   CustomEntityType[]
  customEntityRecords CustomEntityRecord[]
}

// Real, org-scoped catalog data, replacing the old lib/mcp/mock-data.ts
// shared in-memory arrays — each business gets its own products, not a
// hardcoded demo catalog. stockQuantity is folded directly onto Product
// rather than a separate Inventory model: the old mock data already had a
// strict 1:1 product-to-quantity relationship with no second consumer that
// would justify splitting it out (CLAUDE.md #17 — no unnecessary entities).
model Product {
  id             String   @id @default(cuid())
  organisationId String
  sku            String
  name           String
  // Money — Decimal (Postgres numeric), never Float. A price that
  // round-trips through IEEE-754 float arithmetic can drift; Decimal
  // (decimal.js under Prisma) is the standard mapping for currency values.
  unitPrice      Decimal  @db.Decimal(10, 2)
  stockQuantity  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@unique([organisationId, sku])
  @@index([organisationId])
}

model Customer {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  email          String
  company        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@unique([organisationId, email])
  @@index([organisationId])
}

// A business-defined data shape beyond Product/Customer — a landlord's
// Properties, a law firm's Cases, whatever a category needs to look
// something up in that isn't retail/quote-shaped. Deliberately generic
// (name + a field list, same {name, description} shape as
// Agent.extractionFields) rather than real Postgres columns per type:
// there's no way to know a business's field names ahead of time the way
// Product's sku/unitPrice/stockQuantity could be, and adding a table per
// entity type would mean a migration every time a business defines one.
model CustomEntityType {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  fields         Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation         @relation(fields: [organisationId], references: [id])
  records      CustomEntityRecord[]

  @@unique([organisationId, name])
  @@index([organisationId])
}

// One row per record, data held as JSON keyed by the parent
// CustomEntityType's own field names — the record has no fixed columns of
// its own, matching the reasoning on CustomEntityType. organisationId is
// denormalized here (derivable via entityType) so record queries can be
// scoped directly without an extra join, the same trade-off already made
// throughout this schema for tenant isolation checks.
model CustomEntityRecord {
  id             String   @id @default(cuid())
  entityTypeId   String
  organisationId String
  data           Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  entityType   CustomEntityType @relation(fields: [entityTypeId], references: [id])
  organisation Organisation     @relation(fields: [organisationId], references: [id])

  @@index([entityTypeId])
  @@index([organisationId])
}

model User {
  id             String   @id @default(cuid())
  organisationId String
  // Clerk's User id, scoped to this org membership (not globally unique —
  // one Clerk person can belong to more than one organisation via
  // <OrganizationSwitcher/>, each membership gets its own row here).
  clerkUserId    String
  email          String
  name           String
  role           UserRole @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation     Organisation @relation(fields: [organisationId], references: [id])
  approvalsDecided Approval[]

  // Scoped to organisationId, not globally unique — the same real person
  // (same email, same Clerk user) can be a member of more than one
  // organisation, each with its own row here.
  @@unique([organisationId, email])
  @@unique([organisationId, clerkUserId])
  @@index([organisationId])
}

model Agent {
  id             String      @id @default(cuid())
  organisationId String
  name           String
  description    String
  instructions   String
  model          String
  status         AgentStatus @default(DRAFT)
  version        Int         @default(1)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  executionMode        AgentExecutionMode @default(LOOP)
  // Which lib/harness/pipelines/index.ts entry to run — only meaningful
  // when executionMode is HARNESS. Not a foreign key: pipelines are code,
  // not database rows (CLAUDE.md #24 — no generic workflow-node engine yet).
  pipelineKey          String?
  // Deterministic pre-classification, tried before the LLM classifier
  // (lib/routing/deterministic-classify.ts) — if the input contains one of
  // these words/phrases and no other agent's keywords also match, routing
  // skips the LLM call entirely. Empty means "always ask the classifier."
  keywords             String[]           @default([])
  // HARNESS-only: overrides a pipeline's hardcoded default reply subject
  // line (e.g. Complaints' "Re: your recent experience"). Null means "use
  // the pipeline's default" — existing agents with no template set keep
  // behaving exactly as before this field existed.
  replySubjectTemplate String?
  // "acknowledge_reply"-pipeline-only: business-defined fields to pull out
  // of the message, e.g. [{"name":"caseNumber","description":"the case
  // number if mentioned"}]. A fixed "customerEmail" field is always
  // extracted in addition to these regardless of what's configured here —
  // see acknowledge-reply-pipeline.ts — so a business never has to think
  // about identity extraction, only what's specific to their category.
  // Json, not a related table: this is a small, agent-owned list with no
  // independent lifecycle of its own, same reasoning as messages on
  // AgentRun.
  extractionFields     Json               @default("[]")
  // "acknowledge_reply"-pipeline-only: a composed reply is refused (run
  // FAILED, never proposed for approval) if it contains any of these
  // words/phrases, case-insensitive substring match — see
  // pipeline-guards.ts. Generalizes what was a single hardcoded
  // compensation-promise regex on the old Complaints pipeline into a
  // guardrail any business-defined category can configure for itself.
  // Empty means no guardrail is applied.
  guardrailKeywords    String[]           @default([])
  // HARNESS-only: the tool a pipeline proposes as its terminal action (see
  // lib/harness/propose-action.ts). Not a foreign key, same reasoning as
  // pipelineKey — tools are code, validated at runtime against the real
  // MCP tool registry and this agent's own grants, not a DB relation.
  // "send_email" is the only tool that makes sense here today (the only
  // approval-gated, customer-facing action that exists); this field exists
  // now, ahead of a second one, so adding create_invoice/post_slack_message
  // later (once real integrations exist) is additive to the pipeline layer,
  // not a rewrite of it — same reasoning as the AIProvider abstraction
  // existing before a second AI provider did.
  actionTool           String             @default("send_email")

  organisation        Organisation    @relation(fields: [organisationId], references: [id])
  runs                AgentRun[]
  tools               AgentTool[]
  workflowMemberships WorkflowAgent[]

  @@index([organisationId])
}

// Which MCP tools this agent may use (CLAUDE.md #9 step 3: "check the
// agent has access to the tool"). Enforced deterministically in
// lib/runtime/agent-runtime.ts before a tool call ever reaches the MCP
// server — a tool absent here is refused even if the model asks for it,
// not just hidden from what's offered.
model AgentTool {
  id       String @id @default(cuid())
  agentId  String
  toolName String

  agent Agent @relation(fields: [agentId], references: [id])

  @@unique([agentId, toolName])
  @@index([agentId])
}

// A named, reusable pipeline: one classifier agent that decides which
// handler agent should deal with an inbound item, plus the handler agents
// themselves (see lib/routing/dispatch.ts). Kept deliberately simple (a
// flat classifier + handlers list, not a generic node graph) — CLAUDE.md
// #24 says not to build a full workflow editor yet — but it's a real,
// separate entity so a business can eventually have more than one workflow
// (e.g. a future quote-to-production pipeline) without a schema rewrite.
model Workflow {
  id             String              @id @default(cuid())
  organisationId String
  name           String
  description    String
  trigger        WorkflowTriggerType
  // DRAFT: being built, never dispatched to. ACTIVE: live — at most one
  // workflow per (organisationId, trigger) may be ACTIVE at a time,
  // enforced in workflow-service.ts's activateWorkflow, not the database —
  // dispatchInboundMessage's findActiveWorkflowByTrigger uses findFirst,
  // so two ACTIVE workflows on the same trigger would mean one silently,
  // non-deterministically never receives real traffic. ARCHIVED: retired.
  status         AgentStatus         @default(DRAFT)
  source         WorkflowSource      @default(CUSTOM)
  // TEMPLATE-only: which starter template this came from (currently just
  // "email_handling" — see provision-email-workflow.ts). Not a foreign
  // key, same reasoning as Agent.pipelineKey: identifies which piece of
  // code provisioned this, not a row in a templates table. Null for
  // CUSTOM workflows. A real template *registry* (more than one starter
  // to choose from) is later work — this field exists now so adding one
  // is additive, not a schema change.
  templateKey    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organisation Organisation    @relation(fields: [organisationId], references: [id])
  members      WorkflowAgent[]

  @@index([organisationId])
}

model WorkflowAgent {
  id         String            @id @default(cuid())
  workflowId String
  agentId    String
  role       WorkflowAgentRole

  workflow Workflow @relation(fields: [workflowId], references: [id])
  agent    Agent    @relation(fields: [agentId], references: [id])

  @@unique([workflowId, agentId])
  @@index([workflowId])
  @@index([agentId])
}

model AgentRun {
  id             String    @id @default(cuid())
  agentId        String
  organisationId String
  status         RunStatus @default(PENDING)
  input          String
  // Snapshot of the in-progress conversation, saved only when the run
  // pauses for approval — lets resumeRun() pick the loop back up rather
  // than starting the conversation over.
  messages       Json?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  agent        Agent        @relation(fields: [agentId], references: [id])
  organisation Organisation @relation(fields: [organisationId], references: [id])
  steps        RunStep[]
  toolCalls    ToolCall[]
  approvals    Approval[]

  @@index([agentId])
  @@index([organisationId])
}

model RunStep {
  id         String      @id @default(cuid())
  agentRunId String
  stepType   RunStepType
  detail     String?
  toolCallId String?     @unique
  createdAt  DateTime    @default(now())

  // Populated only on steps backed by a real LLM call (AGENT_DECISION
  // today) from AIResponse.usage — null for deterministic steps (TOOL_CALL,
  // INPUT_RECEIVED, etc.), which cost no tokens. Summed on the run detail
  // page so cost is visible per run, not something you rediscover by
  // running a script.
  promptTokens     Int?
  completionTokens Int?

  agentRun AgentRun  @relation(fields: [agentRunId], references: [id])
  toolCall ToolCall? @relation(fields: [toolCallId], references: [id])

  @@index([agentRunId])
}

model ToolCall {
  id         String         @id @default(cuid())
  agentRunId String
  toolName   String
  input      Json
  output     Json?
  status     ToolCallStatus
  error      String?
  createdAt  DateTime       @default(now())

  agentRun AgentRun @relation(fields: [agentRunId], references: [id])
  runStep  RunStep?

  @@index([agentRunId])
}

model Approval {
  id                 String         @id @default(cuid())
  agentRunId         String
  organisationId     String
  requestedAction    String
  reason             String
  // The exact tool-call arguments being held back pending approval (e.g.
  // {to, subject, body} for send_email) and the LLM's id for that call, so
  // the approver reviews the real proposed content — not just an abstract
  // "an email will be sent" — and resumeRun can execute precisely this call.
  // Null for any future post-execution-only approval (see policy-engine.ts).
  proposedInput      Json?
  proposedToolCallId String?
  status             ApprovalStatus @default(PENDING)
  requestedAt        DateTime       @default(now())
  approverId         String?
  decidedAt          DateTime?

  agentRun     AgentRun     @relation(fields: [agentRunId], references: [id])
  organisation Organisation @relation(fields: [organisationId], references: [id])
  approver     User?        @relation(fields: [approverId], references: [id])

  @@index([agentRunId])
  @@index([organisationId])
}

// Stores one OAuth token set per organisation per provider. Tokens are
// plaintext for V1 — server-side only, never sent to the browser, never
// committed (CLAUDE.md #22) — see docs/production-notes.md for the
// encryption-at-rest hardening this needs before any real deployment.
// One connected *account*, not one row per provider — a business can
// connect more than one Gmail address (e.g. sales@ and support@ feeding
// different workflows), and future providers (webhook, Slack, ...) may
// have a "many accounts" shape from day one. provider is a plain string,
// not an enum — validated against lib/integrations/integration-registry.ts
// at the application layer, same reasoning as Agent.pipelineKey/actionTool
// and Organisation.currency: a Postgres enum would need a migration for
// every new provider, forever.
model Integration {
  id             String   @id @default(cuid())
  organisationId String
  provider       String
  // Human-identifiable label for this specific account — the connected
  // Gmail address today. Also the dedup key: reconnecting the same Gmail
  // account updates its row rather than creating a duplicate (see the
  // unique constraint below), while a different address becomes a
  // genuinely new account.
  name           String
  // Non-secret, provider-specific metadata (e.g. Gmail's connected email —
  // duplicated from `name` deliberately, so `name` can be treated as pure
  // UI label without every reader needing to know it's also meaningful
  // data for Gmail specifically). Plaintext — nothing sensitive belongs
  // here, see `credentials` for that.
  config         Json     @default("{}")
  // One encrypted blob (see lib/crypto/token-cipher.ts), not per-field
  // columns — holds whatever secret shape a given provider needs as
  // serialized JSON before encryption (Gmail: {accessToken, refreshToken}).
  // Nullable: not every future provider needs stored credentials (e.g. an
  // inbound-only webhook might not).
  credentials    String?
  // OAuth-style expiry, kept as a real column rather than buried in
  // `config` — refresh-before-expiry is a recurring pattern across OAuth
  // providers (Gmail today, plausibly Slack/Xero/HubSpot later), not a
  // Gmail peculiarity, so keeping it queryable/typed here lets that logic
  // stay provider-agnostic. Null for providers with no expiry concept.
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@unique([organisationId, provider, name])
  @@index([organisationId])
}
