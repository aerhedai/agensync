generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  APPROVER
}

enum AgentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum RunStatus {
  PENDING
  RUNNING
  WAITING_FOR_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum RunStepType {
  INPUT_RECEIVED
  AGENT_DECISION
  TOOL_CALL
  APPROVAL_REQUESTED
  RUN_COMPLETED
  RUN_FAILED
}

enum ToolCallStatus {
  SUCCESS
  FAILED
}

model Organisation {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  agents    Agent[]
  agentRuns AgentRun[]
}

model User {
  id             String   @id @default(cuid())
  organisationId String
  email          String   @unique
  name           String
  role           UserRole @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@index([organisationId])
}

model Agent {
  id             String      @id @default(cuid())
  organisationId String
  name           String
  description    String
  instructions   String
  model          String
  status         AgentStatus @default(DRAFT)
  version        Int         @default(1)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id])
  runs         AgentRun[]

  @@index([organisationId])
}

model AgentRun {
  id             String    @id @default(cuid())
  agentId        String
  organisationId String
  status         RunStatus @default(PENDING)
  input          String
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  agent        Agent        @relation(fields: [agentId], references: [id])
  organisation Organisation @relation(fields: [organisationId], references: [id])
  steps        RunStep[]
  toolCalls    ToolCall[]

  @@index([agentId])
  @@index([organisationId])
}

model RunStep {
  id         String      @id @default(cuid())
  agentRunId String
  stepType   RunStepType
  detail     String?
  toolCallId String?     @unique
  createdAt  DateTime    @default(now())

  agentRun AgentRun  @relation(fields: [agentRunId], references: [id])
  toolCall ToolCall? @relation(fields: [toolCallId], references: [id])

  @@index([agentRunId])
}

model ToolCall {
  id         String         @id @default(cuid())
  agentRunId String
  toolName   String
  input      Json
  output     Json?
  status     ToolCallStatus
  error      String?
  createdAt  DateTime       @default(now())

  agentRun AgentRun @relation(fields: [agentRunId], references: [id])
  runStep  RunStep?

  @@index([agentRunId])
}
